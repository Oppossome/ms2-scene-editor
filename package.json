{
  "name": "ms2sceneeditor",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Extract MapleStory 2 assets and dress characters / build scenes with them",
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "index": "tsx scripts/build-index.ts",
    "extract": "node cmd/extract/extract.js",
    "copy-loose": "node cmd/extract/copy-loose.js",
    "build:vendor": "cd vendor/maple2-file-io && npm install && npx tsc"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.187.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@threlte/core": "^8.7.0",
    "@threlte/extras": "^9.23.1",
    "fast-xml-parser": "^5.12.0",
    "three": "^0.187.0"
  }
}
